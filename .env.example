# Postgres
POSTGRES_USER=signal
POSTGRES_PASSWORD=signal_secret
POSTGRES_DB=signal_db
DATABASE_URL=postgresql://signal:signal_secret@postgres:5432/signal_db

# RabbitMQ
RABBITMQ_USER=signal
RABBITMQ_PASS=signal_secret
RABBITMQ_URL=amqp://signal:signal_secret@rabbitmq:5672

# OpenAI
OPENAI_API_KEY=sk-...

# API
NODE_ENV=development
PORT=3000
# Origens de browser autorizadas a chamar a API diretamente (CORS) — vazio
# por padrão, já que hoje só chamadas server-to-server usam esta API.
# ALLOWED_ORIGINS=https://exemplo.com,https://outro.exemplo.com

# Webhook — segredo compartilhado entre quem envia o lead (CRM externo ou
# o proxy interno em web/app/api/ingest) e a API, para validação HMAC-SHA256
# via header X-Signal-Signature. Gere com: openssl rand -hex 32
WEBHOOK_SECRET=troque_por_um_valor_aleatorio_de_32_bytes

# Dashboard (web) — o app é single-tenant, então é uma senha compartilhada,
# não uma conta por usuário. Sem essas duas variáveis o login fica bloqueado
# (fail-closed), nunca aberto.
# DASHBOARD_PASSWORD: senha exigida na tela de login.
# AUTH_SECRET: chave usada pra assinar o cookie de sessão. Gere com: openssl rand -hex 32
DASHBOARD_PASSWORD=troque_por_uma_senha_forte
AUTH_SECRET=troque_por_um_valor_aleatorio_de_32_bytes
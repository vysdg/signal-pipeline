# Postgres
POSTGRES_USER=signal
POSTGRES_PASSWORD=signal_secret
POSTGRES_DB=signal_db
DATABASE_URL=postgresql://signal:signal_secret@postgres:5432/signal_db

# RabbitMQ
RABBITMQ_USER=signal
RABBITMQ_PASS=signal_secret
RABBITMQ_URL=amqp://signal:signal_secret@rabbitmq:5672

# OpenAI
OPENAI_API_KEY=sk-...

# API
NODE_ENV=development
PORT=3000

# Webhook — segredo compartilhado entre quem envia o lead (CRM externo ou
# o proxy interno em web/app/api/ingest) e a API, para validação HMAC-SHA256
# via header X-Signal-Signature. Gere com: openssl rand -hex 32
WEBHOOK_SECRET=troque_por_um_valor_aleatorio_de_32_bytes